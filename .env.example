# RoadGuard AI Backend Configuration
PROJECT_NAME="RoadGuard AI"
VERSION="1.0.0"
API_PREFIX="/api"

# AI Inference Settings
DEFAULT_MODEL_NAME="pothole_best.pt"
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Database URL
# Local SQLite default:
DATABASE_URL="sqlite:///database/roadguard.db"
# Render / Supabase / Neon PostgreSQL production example:
# DATABASE_URL="postgresql://user:password@host:5432/roadguard"

# CORS Allowed Origins (comma-separated, or leave empty to allow *.vercel.app + localhost)
CORS_ORIGINS="http://localhost:5173,https://your-app.vercel.app"
